{
  "compilerOptions": {
    "target": "es2019",
    "module": "esnext",
    "lib": [
      "esnext"
    ],
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "resolveJsonModule": true
  },
  "include": [
    "src"
  ]
}