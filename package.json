{
  "name": "emoji-today-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "mini-app": "turbo run dev --filter=@emoji-today/mini-app",
    "mini-app:build": "turbo run build --filter=@emoji-today/mini-app",
    "marketing-site": "turbo run dev --filter=emoji.date",
    "marketing-site:build": "turbo run build --filter=emoji.date"
  },
  "devDependencies": {
    "turbo": "latest"
  },
  "packageManager": "yarn@1.22.19"
}
